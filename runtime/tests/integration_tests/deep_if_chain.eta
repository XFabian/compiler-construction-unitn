// EXPECT: 4
f(n : int) : int {
    if (n == 0) {
        return 0
    } else {
        if (n == 1) {
            return 1
        } else {
            if (n == 2) {
                return 2
            } else {
                if (n == 3) {
                    return 3
                } else {
                    return 4
                }
            }
        }
    }
}

main() : int {
    return f(9)
}
