// EXPECT: 2
classify(n : int) : int {
    if (n < 0) {
        return -1
    } else if (n == 0) {
        return 0
    } else if (n < 10) {
        return 1
    } else {
        return 2
    }
}

main() : int {
    total : int = 0
    total = total + classify(-5)
    total = total + classify(0)
    total = total + classify(7)
    total = total + classify(99)
    return total
}
