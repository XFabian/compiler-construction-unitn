// EXPECT: 1
// The heap grew past the shadow stack and the record frames below overwrote
// the array. Both now start at the same address and grow apart.
record P {
    x : int
    y : int
}

use_stack(v : int) : int {
    p : P = P(v, v)
    return p.x + p.y
}

main() : int {
    a : int[10000]
    i : int = 0
    while (i < 10000) {
        a[i] = 5
        i = i + 1
    }
    j : int = 0
    acc : int = 0
    while (j < 200) {
        acc = acc + use_stack(j)
        j = j + 1
    }
    bad : int = 0
    k : int = 0
    while (k < 10000) {
        if (a[k] != 5) {
            bad = bad + 1
        }
        k = k + 1
    }
    if (bad == 0) {
        return 1
    }
    return 0 - bad
}
