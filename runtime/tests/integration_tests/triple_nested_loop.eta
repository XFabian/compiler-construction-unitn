// EXPECT: 27
main() : int {
    c : int = 0
    i : int = 0
    while (i < 3) {
        j : int = 0
        while (j < 3) {
            k : int = 0
            while (k < 3) {
                c = c + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return c
}
