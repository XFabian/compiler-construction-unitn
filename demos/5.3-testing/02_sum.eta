// EXPECT: 55
// A new end-to-end test is one file: copy this into
// runtime/tests/integration_tests/ and it runs, unoptimized and optimized.
sum(n : int) : int {
    s : int = 0
    i : int = 1
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}

main() : int {
    return sum(10)
}
