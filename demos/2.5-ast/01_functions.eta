// A function declares its parameter types and its return type.
// There is no `fn` or `def` keyword: a name, parameters, a colon, a type.
add(a : int, b : int) : int {
    return a + b
}

// A function that returns nothing is called a procedure. No colon, no type.
ignore(x : int) {
    y : int = x + 1
}

main() : int {
    return add(2, 40)
}
