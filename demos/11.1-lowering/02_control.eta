// Demo 7.2's program, with a main.
choose(a : int, b : int) : int {
    x : int
    if (a < b) {
        x = 1
    } else {
        x = 0
    }
    return x
}

count(n : int) : int {
    i : int = 0
    while (i < n) {
        i = i + 1
    }
    return i
}

max(a : int, b : int) : int {
    if (a > b) {
        return a
    }
    return b
}

main() : int {
    return choose(1, 2) * 100 + count(5) * 10 + max(3, 9)
}
