// The straight-line examples of the TAC lecture, in one function.
f(a : int, b : int, A : int[], i : int) : int {
    z : int = a + b * 2         // nested expressions
    c : bool = !(a < -b)        // unary
    x : int = A[i]              // array access
    x, x = x + 1, x * 4         // multi-assign quiz
    a, b = b, a                 // swap
    return z + x
}
