// The quiz: which a does c + a refer to at the marked line?
//
// The same expression appears twice. The trace answers it: inside the block
// lookup(a) finds the inner a, after the block the parameter again.
glob : int = 10
calc(a : int, b : int) {
    c : int = a + b
    {
        a : int = 5
        d : int = c + a    // <- here
    }
    e : int = c + a
}
