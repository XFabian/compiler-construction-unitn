// The control-flow examples of the TAC lecture.
choose(a : int, b : int) : int {
    x : int
    if (a < b) {
        x = 1
    } else {
        x = 0
    }
    return x
}

count(n : int) : int {
    i : int = 0
    while (i < n) {
        i = i + 1
    }
    return i
}

max(a : int, b : int) : int {
    if (a > b) {
        return a
    }
    return b
}
